# ------------------------------------------------------------
# Core: normalize line endings and treat text sensibly
# ------------------------------------------------------------
*               text=auto
*.sh            text eol=lf
*.py            text eol=lf
*.pyw           text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.csv           text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
*.env           text eol=lf
*.bat           text eol=crlf

# ------------------------------------------------------------
# Binary / no-diff files (avoid noisy diffs)
# ------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.bz2           binary
*.7z            binary
*.pkl           binary
*.db            binary
*.sqlite        binary
*.sqlite3       binary

# SVGs are XML (text) — allow diffs and keep LF
*.svg           text eol=lf

# ------------------------------------------------------------
# GitHub Linguist (repo language stats and file classification)
# ------------------------------------------------------------
vendor/**       linguist-vendored
third_party/**  linguist-vendored
dist/**         linguist-generated
build/**        linguist-generated
html/**         linguist-generated
images/**       linguist-generated
docs/**         linguist-documentation
*.md            linguist-documentation
data/**         linguist-vendored

# ------------------------------------------------------------
# Optional: merge strategies for lock/machine files
# ------------------------------------------------------------
# poetry.lock   merge=union
# Pipfile.lock  merge=union

# ------------------------------------------------------------
# Optional: export-ignore for archives
# ------------------------------------------------------------
# .gitattributes export-ignore
# .gitignore     export-ignore
# .github/       export-ignore
# tests/         export-ignore
